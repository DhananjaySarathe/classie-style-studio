# --- Supabase (browser, safe to expose) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Razorpay (browser, KEY_ID only; KEY_SECRET stays in Supabase edge function env) ---
VITE_RAZORPAY_KEY_ID=

# --- Supabase Edge Function secrets ---
# Set with: supabase secrets set KEY=VALUE
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected.
# RAZORPAY_KEY_ID
# RAZORPAY_KEY_SECRET
# RAZORPAY_WEBHOOK_SECRET
# SHIPROCKET_EMAIL          (stubbed)
# SHIPROCKET_PASSWORD       (stubbed)
# MSG91_AUTH_KEY            (stubbed)
# MSG91_TEMPLATE_ID         (stubbed)
# INTERAKT_API_KEY          (stubbed)
# RESEND_API_KEY            (stubbed)
